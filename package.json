{
	"name": "n8n-nodes-readaloud",
	"version": "0.1.0",
	"description": "n8n community node for ReadAloud: convert text to speech (MP3, WAV, Opus, PCM) through the ReadAloud streaming TTS API.",
	"license": "MIT",
	"homepage": "https://github.com/tsushanth/n8n-nodes-readaloud#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"readaloud",
		"text-to-speech",
		"tts",
		"speech"
	],
	"author": {
		"name": "Sushanth Tiruvaipati",
		"email": "78000697+tsushanth@users.noreply.github.com",
		"url": "https://github.com/tsushanth"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tsushanth/n8n-nodes-readaloud.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"test": "n8n-node build && node --test \"test/*.test.js\""
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/ReadAloudApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/ReadAloud/ReadAloud.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"bugs": {
		"url": "https://github.com/tsushanth/n8n-nodes-readaloud/issues"
	}
}
